{
    "name": "venusian-voyager/bus",
    "description": "The Voyager Bus package.",
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        },
        {
            "name": "Taylor Otwell"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "laravel/serializable-closure": "^2.0",
        "nesbot/carbon": "^3.8.4",
        "venusian-voyager/collections": "^0.10.0",
        "venusian-voyager/conditionable": "^0.10.0",
        "venusian-voyager/contracts": "^0.10.0",
        "venusian-voyager/nuts-and-bolts": "^0.10.0",
        "venusian-voyager/pipeline": "^0.10.0",
        "venusian-voyager/queue": "^0.10.0",
        "venusian-voyager/vessel": "^0.10.0"
    },
    "suggest": {
        "venusian-voyager/database": "Required to keep batches in the database (^0.10.0)."
    },
    "autoload": {
        "psr-4": {
            "Voyager\\Bus\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
}
